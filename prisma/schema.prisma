generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {`
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  phone           String?
  username        String?   @unique
  displayUsername String?
  bio             String?
  avatarUrl       String?
  role            Role      @default(USER)
  categories Category[]
  transactions Transaction[]
  accounts        Account[]
  sessions        Session[]
  push_tokens   PushToken[]
  notifications Notification[]
    budgets Budget[]

  @@map("users")
}
enum Role {
  USER
  ADMIN
}

model Category {
  id        String       @id @default(cuid())
  name      String
  icon      String
  color     String
  description String?

  type      CategoryType
  is_system Boolean      @default(false)
  user_id   String?
  user      User?        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
transactions Transaction[]
  budgets Budget[]
  @@map("categories")
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  category_id String
  category    Category        @relation(fields: [category_id], references: [id])
  user_id     String
  user        User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // self-relation — expense can be tied to an income transaction
  income_id   String?
  income      Transaction?    @relation("IncomeExpenses", fields: [income_id], references: [id])
  expenses    Transaction[]   @relation("IncomeExpenses")

  budget_id   String?
  budget      Budget?         @relation("BudgetTransactions", fields: [budget_id], references: [id], onDelete: SetNull)

  budgetedIncomes Budget[]    @relation("BudgetIncome")

  source_name String?
  notes       String?
  receipt_url String?
  tag         String?
  recorded_at DateTime
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}


model PushToken {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   // "ios" | "android"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("push_tokens")
}

model Notification {
  id         String             @id @default(cuid())
  user_id    String
  user       User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  data       Json?              // extra payload
  read       Boolean            @default(false)
  created_at DateTime           @default(now())

  @@map("notifications")
}

enum NotificationType {
  LOW_BALANCE
  WEEKLY_SUMMARY
  TRANSACTION_ADDED
  SAVINGS_GOAL_REACHED
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verifications")
}

model Budget {
  id          String       @id @default(cuid())
  user_id     String
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category_id String?
  category    Category?    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  income_id   String?
  income      Transaction? @relation("BudgetIncome", fields: [income_id], references: [id], onDelete: SetNull)
  amount      Decimal      @db.Decimal(12, 2)
  period      BudgetPeriod @default(MONTHLY)
  start_date  DateTime
  is_archived Boolean      @default(false)
  archived_at DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  transactions Transaction[] @relation("BudgetTransactions")

  @@unique([user_id, category_id, income_id, period])
  @@map("budgets")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}
